CXX = g++
CXXFLAGS = -O2 -std=c++03 -fpermissive -w -I../../src/libEAQUAL -I../../src/GlobalHeaders $(shell pkg-config --cflags sndfile)
SRCS_LIB = $(wildcard ../../src/libEAQUAL/*.cpp)
SRCS_FE  = ../../src/EAQUALFrontEnd/EAQUALMain.cpp ../../src/EAQUALFrontEnd/EAQUALArgs.cpp ../../src/EAQUALFrontEnd/EAQUALOutput.cpp
OBJS = $(SRCS_LIB:.cpp=.o) $(SRCS_FE:.cpp=.o)
../../bin/EAQUAL: $(OBJS)
	@mkdir -p ../../bin
	$(CXX) $(OBJS) $(shell pkg-config --libs sndfile) -lm -o $@
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@
clean:
	rm -f $(OBJS) ../../bin/EAQUAL
